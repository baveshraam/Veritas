# PostGIS + pgvector in one instance — our schema uses geometry columns AND the
# vector store is pgvector, so both extensions must live in the same database.
FROM postgis/postgis:16-3.4
RUN apt-get update \
 && apt-get install -y --no-install-recommends postgresql-16-pgvector \
 && rm -rf /var/lib/apt/lists/*
