# Copy to .env and adjust. Defaults match docker-compose.yml.
VERITAS_POSTGRES_DSN=postgresql+psycopg://veritas:veritas@localhost:5432/veritas

# Auth. Catalyst Authentication takes over wherever CATALYST_PROJECT_ID is set (i.e.
# every deployed environment); the self-signed JWT below is the local/offline path.
# VERITAS_JWT_SECRET=
VERITAS_DEV_MODE=1

# Catalyst — set in the AppSail service environment, not here. When present, the API
# authenticates callers via Catalyst Authentication and renders PDFs via SmartBrowz.
# CATALYST_PROJECT_ID=

# LLM synthesis (optional — the engine runs deterministically without it).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
