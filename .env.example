# Copy to .env and adjust. See CLAUDE.md for the full architecture.

# Auth. Catalyst Authentication takes over wherever CATALYST_PROJECT_ID is set (i.e.
# every deployed environment); the self-signed JWT below is the local/offline path.
# VERITAS_JWT_SECRET=
VERITAS_DEV_MODE=1

# Catalyst project and org — the Admin API needs these for provision and seed.
# Inside AppSail the SDK authenticates as the app; locally you need the CLI login.
CATALYST_PROJECT_ID=52852000000013048
CATALYST_ORG=60077763394

# QuickML LLM Serving (optional — the engine runs deterministically without it).
# Inside AppSail the SDK credentials work. No API key in the image.
QUICKML_ENDPOINT=
# Per-endpoint secret from the console's Model Details -> API Details popup
# (X-QUICKML-ENDPOINT-KEY). Documented for QuickML's sibling "pipeline endpoints"
# REST surface; not obtainable over the Admin API this project provisions with —
# see BUG-022 in docs/PHASE1_FAILURE_LOG.md. Leave blank until someone copies it
# from the console; the header is simply omitted until then.
QUICKML_ENDPOINT_KEY=
VERITAS_LLM_MODEL=glm-4.7-flash

# Cron/Jobs token — protects the /jobs/refresh and /jobs/audit-verify endpoints.
# VERITAS_JOB_TOKEN=

# CORS origins for the Command Console (comma-separated).
VERITAS_CORS_ORIGINS=http://localhost:3000
