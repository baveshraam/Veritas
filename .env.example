# Copy to .env and adjust. See CLAUDE.md for the full architecture.

# Auth. Catalyst Authentication takes over wherever CATALYST_PROJECT_ID is set (i.e.
# every deployed environment); the self-signed JWT below is the local/offline path.
# VERITAS_JWT_SECRET=
VERITAS_DEV_MODE=1

# Catalyst project and org — the Admin API needs these for provision and seed.
# Inside AppSail the SDK authenticates as the app; locally you need the CLI login.
CATALYST_PROJECT_ID=52852000000013048
CATALYST_ORG=60077763394

# QuickML LLM Serving (optional — the engine runs deterministically without it).
# Reached over the official REST API (api.catalyst.zoho.in/quickml/v1/...), not the Python
# SDK's quick_ml().predict() — that path hits a platform-wide ORGID_HEADER_UNAVAILABLE gap
# on every Catalyst runtime (see docs/ENGINEERING_BRIEF.md Sec12). Auth is a dedicated
# self-client (Zoho API Console -> create client -> Self Client tab), scoped to
# QuickML.deployment.READ — a machine identity, not a developer's personal login.
QUICKML_CLIENT_ID=
QUICKML_CLIENT_SECRET=
QUICKML_SCOPE=QuickML.deployment.READ
QUICKML_ACCOUNTS_URL=https://accounts.zoho.in
# The one value that requires a human, one time: in the Self Client tab, generate a grant
# token (scope QuickML.deployment.READ, ~10 min validity), then exchange it immediately —
# it's single-use and short-lived — for a refresh_token via:
#   POST {QUICKML_ACCOUNTS_URL}/oauth/v2/token?grant_type=authorization_code
#        &client_id=...&client_secret=...&code=<grant_token>
# Store only the resulting refresh_token here (or in AppSail configuration in production).
QUICKML_REFRESH_TOKEN=
QUICKML_MODEL_ID=crm-di-glm47b_30b_it
VERITAS_LLM_MODEL=glm-4.7-flash

# Cron/Jobs token — protects the /jobs/refresh and /jobs/audit-verify endpoints.
# VERITAS_JOB_TOKEN=

# CORS origins for the Command Console (comma-separated).
VERITAS_CORS_ORIGINS=http://localhost:3000
